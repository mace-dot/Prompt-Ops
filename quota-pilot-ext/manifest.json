{
  "manifest_version": 3,
  "name": "Quota Pilot",
  "version": "0.2.0",
  "description": "Local instant prompt compression with a non-destructive preview, plus ChatGPT / Claude / Gemini quota windows.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quota Pilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "trim.js",
        "quota.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "trim-prompt": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Open optimized prompt preview (does not overwrite)"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
